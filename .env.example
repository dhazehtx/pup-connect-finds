# Copy this file to `.env` at the **repo root** (same folder as package.json).
# Vite is configured with `envDir` = repo root, and the server loads this file first — one `.env` for client + API.
# Drizzle uses Postgres: Supabase projects expose the same database via `DATABASE_URL` (connection string
# under Project Settings → Database) while the Supabase JS client uses `VITE_SUPABASE_URL` + anon key.

# Neon PostgreSQL (get a free URL at https://neon.tech)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# Or use this key instead:
# NEON_DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Optional: Hugging Face — enables AI photo matching on Lost & Found “AI Match”
# Create a token at https://huggingface.co/settings/tokens (read access)
# HF_TOKEN=hf_xxxxxxxx
# Optional: override image embedding model (default: google/vit-base-patch16-224)
# HF_IMAGE_EMBEDDING_MODEL=google/vit-base-patch16-224

# Optional: minimum CLIP similarity (0–1) for marketplace hits in AI Match.
# Default is server/lib/aiMatchConfig.ts (AI_MATCH_DEFAULT_MIN_LISTING_SCORE). Tune without labeled data:
#   npm run tune:ai-match
# AI_MATCH_MIN_LISTING_SCORE=0.68

# Optional: min CLIP similarity (0–1) to send automatic lost↔found “possible photo match” notifications (default 0.78)
# EMBEDDING_MATCH_NOTIFY_MIN_SCORE=0.78

# Optional: AI Match quality monitor thresholds (nightly rollup job)
# AI_MATCH_MONITOR_MIN_REQUESTS=20
# AI_MATCH_MONITOR_MAX_FALLBACK_RATE=0.40
# AI_MATCH_MONITOR_MAX_EMPTY_RATE=0.25
# AI_MATCH_MONITOR_MIN_AVG_TOP_SCORE=0.62
# Optional: outbound quality alerts
# AI_MATCH_MONITOR_WEBHOOK_URL=https://hooks.slack.com/services/...
# AI_MATCH_MONITOR_ALERT_EMAILS=ops@yourapp.com,alerts@yourapp.com

# --- Supabase (required for auth middleware) ---
# SUPABASE_URL=https://xxxx.supabase.co
# Or reuse the client key name:
# VITE_SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJ... (service role, server-only; never expose to the client)

# --- Sentry (error monitoring) — never commit real DSNs; inject via host secrets in production ---
# Server (Node): required for /api/internal/sentry/test-error and server-side errors
# SENTRY_DSN=https://xxxx@xxxx.ingest.sentry.io/xxxx
# Optional: override default environment (defaults from NODE_ENV: development | staging | production)
# SENTRY_ENVIRONMENT=staging
# Optional: release string (e.g. git SHA)
# SENTRY_RELEASE=abc1234
# Production only: required for POST /api/internal/sentry/test-error (header: X-Sentry-Test-Secret)
# SENTRY_TEST_SECRET=your-long-random-secret

# Optional: enable verbose server API trace logs ([PROOF:*], rate-limit diagnostics) in production.
# Default is off in production; development always logs traces unless you rely on NODE_ENV=production locally.
# DEBUG_API=1
#
# Profile privacy (stored in profiles.privacy_settings JSON — merged on PATCH):
# show_location_on_public_profile / show_website_on_public_profile must be true to show on public profile.

# Client (Vite): set at build time; embedded in bundle for browser SDK (do not log or return in APIs)
# VITE_SENTRY_DSN=https://xxxx@xxxx.ingest.sentry.io/xxxx
# VITE_SENTRY_ENVIRONMENT=staging
# VITE_SENTRY_RELEASE=abc1234

# --- Support contact form (POST /api/support/contact) ---
# Inbox that receives contact form submissions (required for the form to be "enabled")
# SUPPORT_INBOX_EMAIL=support@yourdomain.com
# Optional: public address shown on /contact (defaults to SUPPORT_INBOX_EMAIL if unset)
# SUPPORT_PUBLIC_EMAIL=support@yourdomain.com
# Outbound email (SendGrid) — required for actual email delivery
# SENDGRID_API_KEY=SG.xxxx
# SENDGRID_FROM=noreply@yourdomain.com

# --- Staging (optional separate file) ---
# For NODE_ENV=staging, copy .env.staging.example → .env.staging and set staging-only values.
# Load order: .env first, then .env.staging overrides when NODE_ENV=staging (see server/env/loadEnv.ts).

# --- Payments & platform fees (Stripe) ---
# Webhook: point Stripe to POST /api/webhooks/stripe (canonical; /api/stripe/webhook uses same checkout completion logic).
#
# Platform take — defaults are 0 at launch; set when you want commission:
# PLATFORM_FEE_PERCENT=0
# CONNECT_APP_FEE_BPS=0
#
# Pup Box SKUs — JSON array. Keys MUST be exactly:
# small_subscription | small_one_time | medium_subscription | medium_one_time | large_subscription | large_one_time
# After setting, run: npm run store:sync-catalog (upserts Pup Box rows + main CSV catalog).
#
# PUPBOX_CATALOG_JSON=[{"key":"small_subscription","stripeProductId":"prod_xxx","stripePriceId":"price_xxx","amount":"19.99","recurring":true,"name":"Small Pup Box Monthly"},{"key":"small_one_time","stripeProductId":"prod_yyy","stripePriceId":"price_yyy","amount":"23.99","recurring":false,"name":"Small Pup Box One-Time"}]
#
# Client build (optional) — mirrors CONNECT_APP_FEE_BPS for UI display only:
# VITE_CONNECT_APP_FEE_BPS=0
