# Staging — copy to `.env.staging` and fill with your staging project values.
# Activate by setting NODE_ENV=staging before `node dist/index.js` or `tsx server/index.ts`.
# Base keys may also live in `.env`; values here override when NODE_ENV=staging (see server/env/loadEnv.ts).
#
# Client bundle: use `npm run build:staging` so Vite loads this file (`vite build --mode staging`).

# -----------------------------------------------------------------------------
# Public app URL (staging domain, HTTPS, no trailing slash)
# Exposed to the client when using Vite envPrefix NEXT_PUBLIC_ (see vite.config.ts)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_BASE_URL=https://staging.example.com

# Same URL for server-side redirects / emails if your code reads these (optional)
# BASE_URL=https://staging.example.com
# CLIENT_URL=https://staging.example.com
# APP_URL=https://staging.example.com

# -----------------------------------------------------------------------------
# Database (dedicated staging only — must NOT contain "prod" / "production" in the URL
# or assertEnvironmentSafety() will refuse to start with NODE_ENV=staging)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@staging-host/staging-db?sslmode=require

# -----------------------------------------------------------------------------
# Supabase (staging project — separate from production)
# Server often reads VITE_* or SUPABASE_* — keep staging project values in sync.
#
# In Supabase Dashboard → Authentication → URL Configuration, add for this staging app:
#   Site URL: same as NEXT_PUBLIC_BASE_URL above
#   Redirect URLs: include https://staging.example.com/** and paths used by auth:
#     https://staging.example.com/verify-email
#     https://staging.example.com/reset-password
#     https://staging.example.com/ (email confirmation)
# -----------------------------------------------------------------------------
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.staging-anon
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.staging-anon

SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.staging-service-role

# -----------------------------------------------------------------------------
# Stripe TEST mode (staging must not use live keys)
# server/lib/config.ts uses test key paths when NODE_ENV=staging (see STRIPE_USE_LIVE_KEYS).
# You may use STRIPE_SECRET_KEY_TEST / STRIPE_WEBHOOK_SECRET_TEST instead of the generic names.
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_staging_test_xxxxxxxx
VITE_STRIPE_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: align server/lib/config.ts APP_ENV with staging
# NEXT_PUBLIC_APP_ENV=staging

# Optional: Sentry (separate DSN or environment filter recommended)
# SENTRY_DSN=
# VITE_SENTRY_DSN=
